# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (used by Nest + TypeORM CLI / data-source) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lemea_db

# TypeORM: never set TYPEORM_SYNC=true in production (schema auto-alter is unsafe).
# Local quick iteration only. Production: false + run migrations.
TYPEORM_SYNC=false

# Optional: run pending migrations when the Nest app boots (e.g. simple Docker).
# Prefer running `npm run migration:run` in your deploy pipeline instead.
TYPEORM_MIGRATIONS_RUN=false

# Optional: log SQL from TypeORM
TYPEORM_LOGGING=false

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string

# --- CORS (comma-separated origins; required for deployed frontend) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Email (orders / reviews notifications) ---
EMAIL=
EMAIL_PASS=

# Legacy aliases (optional; data-source falls back if POSTGRES_* unset)
# DB_HOST=
# DB_PORT=
# DB_USERNAME=
# DB_PASSWORD=
# DB_NAME=
