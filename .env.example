# --- Runtime ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL (used by Nest + TypeORM CLI / data-source) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=lemea_db

# TypeORM: never set TYPEORM_SYNC=true in production (schema auto-alter is unsafe).
# Local quick iteration only. Production: false + run migrations.
TYPEORM_SYNC=false

# Optional: run pending migrations when the Nest app boots (e.g. simple Docker).
# Prefer running `npm run migration:run` in your deploy pipeline instead.
TYPEORM_MIGRATIONS_RUN=false

# Optional: log SQL from TypeORM
TYPEORM_LOGGING=false

# --- Auth ---
JWT_SECRET=your_jwt_secret_key_here

# --- CORS (comma-separated origins; required for deployed frontend) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- Cloudinary (Media storage & uploads) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_key_here
CLOUDINARY_API_SECRET=your_secret_here

# --- Email Notifications (Resend / SMTP) ---
EMAIL=your_email@example.com
EMAIL_PASS=your_email_password_here
RESEND_API_KEY=re_your_resend_api_key_here

# Legacy aliases (optional; data-source falls back if POSTGRES_* unset)
# DB_HOST=
# DB_PORT=
# DB_USERNAME=
# DB_PASSWORD=
# DB_NAME=
